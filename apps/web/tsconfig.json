{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": { "~/*": ["./app/*"] },
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vite/client"]
  },
  "include": ["app", ".react-router/types/**/*", "vite.config.ts"]
}
